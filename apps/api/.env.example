# Copy to .env for local development. On Railway, set these in the API service's Variables.

# Leave unset locally to use the embedded database in <repo>/.data.
# On Railway use the private URL (${{Postgres.DATABASE_URL}}).
# DATABASE_URL=postgres://user:pass@host:5432/railway

PORT=4000

# The addresses the browser uses. Requests that change data must come from one of these.
APP_ORIGIN=http://localhost:3000
OPS_ORIGIN=http://localhost:3000

# Production: APP_ORIGIN=https://app.vaweinterio.in  OPS_ORIGIN=https://ops.vaweinterio.in
