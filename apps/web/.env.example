# Copy to .env.local for local development. On Railway, set these in the web service's Variables.

# Where the Hono API listens. On Railway use the private address, e.g. http://api.railway.internal:4000
API_URL=http://localhost:4000

# Production only: which hostname serves the dashboard and which serves the ops console.
# Leave both unset locally and every page is served from localhost:3000.
# APP_HOST=app.vaweinterio.in
# OPS_HOST=ops.vaweinterio.in
